# Public canonical origin, set before production build
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# HTTPS endpoint for a form provider or your CRM. Must return 2xx only on acceptance.
CONTACT_WEBHOOK_URL=
# Optional server-only bearer token
CONTACT_WEBHOOK_SECRET=
# Optional scheduling URL. Without it, visitors use the inquiry form.
NEXT_PUBLIC_BOOKING_URL=

# GitHub Pages: public HTTPS form-service endpoint (CORS + JSON submissions).
# Configure as a GitHub Actions repository variable. Never put secrets here.
NEXT_PUBLIC_CONTACT_ENDPOINT=
